<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
  ===========================================================================
   NARRATOR GENERATYWNY - zestaw hybrydowy
  ===========================================================================

  ZASADA: podmieniamy DOKLADNIE te compy, ktore decyduja o tym, JAKIE wydarzenia
  narracyjne spotykaja gracza na mapie kolonii i KIEDY. Cala reszta - handel,
  goscie, choroby, questy, wydarzenia biomowe, orbita - zostaje waniliowa.

  Po co: ewaluacja porownawcza z Cassandra ma byc eksperymentem KONTROLOWANYM.
  Rozniac sie mamy dokladnie tam, gdzie praca twierdzi, ze wnosi wklad, a nie
  tym, ze u nas nie ma handlarzy. Bez tego porownanie mierzyloby braki
  implementacyjne, a nie jakosc generacji narracyjnej.

  Cassandra ma 20 compow wlasnych. My:
    PODMIENIAMY 3     OnOffCycle(ThreatBig), OnOffCycle(ThreatSmall),
                      CategoryMTB(Misc, Map_PlayerHome)
                      -> jeden StorytellerCompProperties_Generative
    PRZEJMUJEMY 17    reszta, skopiowana z Cassandry bez zmian
    DZIEDZICZYMY      BaseStoryteller (questy koncowe, infrastruktura DLC)

  KALIBRACJA TEMPA - czestotliwosc podmienianych compow u Cassandry:
    OnOffCycle ThreatBig    1~2 incydentow / (4.6 on + 6.0 off) = ~0.14 /dzien
    OnOffCycle ThreatSmall  0.2~1 incydentu / 10.6 dnia         = ~0.06 /dzien
    CategoryMTB Misc        mtbDays 4.8                          = ~0.21 /dzien
                                                          RAZEM   ~0.40 /dzien
  Stad mtbDays = 2.5 (1 / 0.40). Dzieki temu nasz narrator generuje podobny
  BUDZET wydarzen co Cassandra, a porownanie dotyczy tresci i kontekstu,
  a nie samej liczby zdarzen.
  ===========================================================================
  -->

  <StorytellerDef ParentName="BaseStoryteller">
    <defName>PN_GenerativeNarrator</defName>
    <label>Ariadne Generative</label>
    <description>Ariadne nie losuje wydarzen z gotowej listy. Sklada je z elementarnych klockow - aktora, akcji, celu i modyfikatora - polaczonych grafem kompatybilnosci, tak by kazde zdarzenie mialo sens w biezacej sytuacji kolonii.\n\nPoza torem wydarzen narracyjnych zachowuje sie jak Cassandra: handel, goscie, choroby i questy dzialaja bez zmian.\n\nEksperymentalny narrator z pracy inzynierskiej: system proceduralnej generacji wydarzen narracyjnych oparty o metody klasycznej sztucznej inteligencji.</description>
    <portraitLarge>UI/HeroArt/Storytellers/PN_Generative</portraitLarge>
    <portraitTiny>UI/HeroArt/Storytellers/PN_GenerativeTiny</portraitTiny>
    <listOrder>50</listOrder>

    <comps>

      <!-- ================= NASZ TOR: wydarzenia narracyjne ================= -->
      <!-- Zastepuje OnOffCycle(ThreatBig) + OnOffCycle(ThreatSmall)
           + CategoryMTB(Misc) z Cassandry. Ograniczony do mapy kolonii,
           bo klocki opisuja osade ("Rzecz dzieje sie w sercu osady"). -->
      <li Class="ProceduralNarrator.Integration.Storyteller.StorytellerCompProperties_Generative">
        <mtbDays>2.5</mtbDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>

        <!--
        =====================================================================
         WARSTWA DECYZYJNA (krok 3) - kalibracja utility AI
        =====================================================================
        UWAGA: brak ktoregokolwiek z ponizszych wezlow NIE jest bledem - pole
        zostanie wtedy na wartosci domyslnej z kodu. Jest to jednak CICHA
        awaria, gdy wezel istnieje, ale ma literowke w nazwie: RimWorld pomija
        nieznane wezly bez slowa. Dlatego PNStartup wypisuje do Player.log
        linie "Parametry decyzyjne (PN_GenerativeNarrator): ..." z wartosciami
        EFEKTYWNYMI - to jedyny dowod, ze ten blok w ogole zadzialal.
        -->

        <!-- Budzet OCEN na jedna decyzje: gorna granica liczby zlozonych
             i ocenionych kandydatow. Dzisiejszy katalog (12 dostepnych akcji,
             84 kombinacje) miesci sie w calosci, wiec decyzja jest w 100%
             enumeracyjna i nie zuzywa ANI JEDNEGO losowania przy generowaniu
             kandydatow - to najlepszy mozliwy punkt wyjscia do ewaluacji.
             Przy okolo 40 akcjach warto przejsc na B = max(400, 8 * akcji),
             zeby limit na akcje nie spadl ponizej 8 wariantow. -->
        <candidateBudget>400</candidateBudget>

        <!-- Prog BEZWZGLEDNY jakosci. Kandydat slabszy niz to nie wchodzi do
             losowania NIGDY, niezaleznie od tego, jak slaba jest reszta stawki.
             To jedyna gwarancja "narrator nie odpali bzdury": pasmo near-best
             jej nie daje, bo jest wzgledne i opada razem z jakoscia stawki
             w kolejnych rundach. Nie obnizac "tymczasowo" przy strojeniu. -->
        <qualityCutoff>0.35</qualityCutoff>

        <!-- Pasmo near-best: do losowania wchodza kandydaci w promieniu 25%
             od najlepszego DOSTEPNEGO. Przeliczane w kazdej rundzie od nowa,
             wiec po odmowie silnika pasmo opada i wpuszcza kolejnych. -->
        <nearBestFraction>0.75</nearBestFraction>

        <!-- Temperatura softmaksu. 0.1 jest OSTRE: roznica 0.1 uzytecznosci to
             czynnik e = 2.72, roznica 0.3 to czynnik 20. Ta liczba decyduje,
             czy narrator jest przewidywalny (male T), czy rozstrzelony (duze T),
             i jest glownym zrodlem czulosci udzialu PASS na liczbe kandydatow
             w pasmie. -->
        <softmaxTemperature>0.1</softmaxTemperature>

        <!-- Temperatura BRAMY "czy w ogole dzialac": dwuelementowego softmaksu miedzy
             najlepszym dostepnym zdarzeniem a cisza.

             PO CO ODDZIELNA BRAMA. Wczesniej PASS wchodzil do TEJ SAMEJ puli softmaksu co
             zdarzenia, wiec jego szansa byla dzielona przez ich licznosc: przy 15 kandydatach
             cisza byla kilkakrotnie bardziej prawdopodobna niz przy 37, mimo IDENTYCZNEJ
             sytuacji w kolonii. Udzial swiadomego milczenia zalezal zatem od ROZMIARU
             KATALOGU KLOCKOW, a nie od stanu rozgrywki. Zmierzone na 8 decyzjach z gry:
             udzial PASS 0.25%, czyli jeden PASS na ~405 decyzji (~1000 dni gry) - przy pelnej
             sprawnosci samego mechanizmu gestosci (passWynik rosl 0.250 -> 0.489). Koncepcja
             wymaga natomiast, by PASS byl pelnoprawna decyzja sterujaca tempem.

             Brama widzi DOKLADNIE DWIE opcje, wiec jej wynik nie zalezy od licznosci puli.

             DLACZEGO NIE TA SAMA LICZBA CO softmaxTemperature: brama porownuje uzytecznosci
             normalizowane po ROZLACZNYCH zestawach wag (<weights> kontra <pass>), czyli
             wielkosci NIEWSPOLMIERNE - ich zestawienie jest konwencja kalibrowana empirycznie.
             Etap B porownuje zdarzenia miedzy soba, czyli wielkosci wspolmierne z konstrukcji.
             Zwiazanie tych dwoch niepewnosci jedna liczba oznaczaloby, ze strojenie udzialu
             ciszy zmienia przy okazji ostrosc wyboru miedzy zdarzeniami.

             Wartosc rowna softmaxTemperature jest CELOWA I TYMCZASOWA: nie mamy jeszcze danych,
             ktore uzasadnialyby inna, a wpisanie tu liczby "na oko" udawaloby kalibracje,
             ktorej nie przeprowadzono. Do przestrojenia po zebraniu okolo 50 decyzji.

             STROJENIE UDZIALU PASS - dwa pokretla, w tej kolejnosci:
               1. <densitySaturation> w bloku <pass> - ZMIENIA, kiedy cisza jest cenna
                  (nizsza wartosc = cisza szybciej zyskuje na wartosci przy zageszczeniu).
               2. gateTemperature - ZMIENIA, jak ostro brama reaguje na roznice uzytecznosci
                  (wyzsza = brama bardziej losowa, udzial PASS blizszy 50%).
             Kolumna "pBrama" w PN_decyzje.log podaje udzial ciszy WPROST, w kazdej turze,
             niezaleznie od tego, co faktycznie wylosowano - wiec da sie go usrednic po turach
             zamiast czekac na rzadkie wygrane PASS. -->
        <gateTemperature>0.1</gateTemperature>

        <!-- Weto spojnosci: kandydat o dopasowaniu kontekstowym ponizej tego
             progu jest odrzucany bezwarunkowo. Prog czyta wartosc SUROWA, wiec
             jest NIEZALEZNY od wagi contextFit - wyzerowanie tej wagi ponizej
             wylacza wplyw dopasowania na wynik, ale NIE znosi weta. -->
        <vetoContextFitBelow>0.15</vetoContextFitBelow>

        <!-- Budzet rund petli wyboru. NIE jest to zabezpieczenie poprawnosci:
             petla konczy sie sama, bo kazda runda bez trafienia usuwa dokladnie
             jednego kandydata z puli. Jest to budzet KOSZTU, bo CanFireNow bywa
             drogie (Infestation przeszukuje mape). 8 to odpowiednik dawnego
             MaxCompositionAttempts = 6 z zapasem. -->
        <maxSelectionRounds>8</maxSelectionRounds>

        <!-- Wagi czynnikow ZDARZENIOWYCH. Nazwa wezla == nazwa pola == nazwa
             czynnika w sladzie decyzji; to inwariant, nie zbieg okolicznosci.
             Wynik jest srednia WAZONA znormalizowana przez sume wag, wiec licza
             sie wylacznie PROPORCJE miedzy nimi, a nie wartosci bezwzgledne.
             Czynnik o wadze 0 jest dokladnie NEUTRALNY (wnosi 0 do licznika
             i 0 do mianownika), a nie rozcienczajacy - dlatego intentAlignment
             moze byc juz wpiety, mimo ze krzywa dramaturgiczna wchodzi w kroku 4. -->
        <weights>
          <!-- Najwyzsza waga, bo spojnosc z sytuacja kolonii jest glownym
               deklarowanym wkladem pracy wobec narratorow waniliowych. -->
          <contextFit>2.0</contextFit>
          <!-- Roznorodnosc - czynnik, ktory ma odsuwac powtorki tematu i akcji.
               Ponizej contextFit, bo swieze, ale bezsensowne zdarzenie jest
               gorsze niz trafne powtorzenie. -->
          <freshness>1.5</freshness>
          <!-- Potencjal dramaturgiczny liczony jako kontrast wobec rytmu
               ostatnich zdarzen. Najnizsza z aktywnych wag: ma modulowac wybor,
               a nie przejmowac sterowanie. -->
          <dramaticContrast>1.0</dramaticContrast>
          <!-- 0 do konca kroku 3: krzywej dramaturgicznej jeszcze nie ma,
               intencja jest na stale Hold. Czynnik jest MIMO TO liczony
               i trafia do sladu, zeby format logu badawczego byl identyczny
               w kroku 3 i 4 i nie wymuszal przepisania skryptow w Pythonie. -->
          <intentAlignment>0</intentAlignment>
        </weights>

        <!-- Pseudo-kandydat PASS (swiadoma cisza) - ROZLACZNA przestrzen wag.
             Nazwa "intentAlignment" powtarza sie wzgledem <weights> CELOWO:
             obie przestrzenie sa walidowane i kalibrowane niezaleznie i nie
             wolno ich unifikowac "dla porzadku".
             UWAGA metodologiczna: uzytecznosc PASS i uzytecznosc zdarzenia sa
             normalizowane po ROZNYCH zestawach wag, wiec ich porownanie
             w softmaksie jest KONWENCJA kalibrowana empirycznie. -->
        <pass>
          <!-- Polowiczny zanik pamieci o zdarzeniu, w dniach gry.
               Wyprowadzenie: 2 * mtbDays = 2 * 2.5 = 5.0, czyli pamiec o dwa
               typowe odstepy miedzy wydarzeniami. -->
          <halfLifeDays>5</halfLifeDays>
          <!-- Gestosc zdarzen, ponizej ktorej cisza nie jest nic warta.
               Oczekiwana gestosc w stanie ustalonym to E[D] = H / (mtb * ln2)
               = 5 / (2.5 * 0.6931) = 2.886; podloga to 0.52 * E[D]. -->
          <densityFloor>1.5</densityFloor>
          <!-- Gestosc, przy ktorej cisza jest maksymalnie cenna: 1.56 * E[D].
               PIERWSZE z dwoch pokretel strojenia udzialu PASS (drugim jest
               gateTemperature wyzej). Gdy zmierzony udzial przekroczy 12%, PODNIES
               te wartosc; gdy jest za niski, OBNIZ ja. Nie ruszaj wag: nizsze
               weightRestraint podnosi PODLOGE uzytecznosci ciszy i daje efekt
               odwrotny do zamierzonego.
               Zaleznosc jest liniowa i latwa do policzenia z logu:
                 passWynik = weightRestraint * r + weightBaseline,  gdzie
                 r = (gestosc - densityFloor) / (densitySaturation - densityFloor),
               zweryfikowane na danych z gry co do trzeciego miejsca po przecinku. -->
          <densitySaturation>4.5</densitySaturation>
          <!-- Straznik serii: ile PASS-ow z rzedu wolno, zanim PASS zostanie
               wykluczony z losowania (0 wylacza straznika). Ubezpieczenie przed
               zla konfiguracja, a nie normalny tryb pracy - przy tych wartosciach
               nie powinien nigdy zadzialac. Nie dziala przy pustej puli zdarzen:
               straznik ogranicza milczenie Z WYBORU, a nie zmusza narratora
               do odpalenia wydarzenia, ktorego nie ma. -->
          <maxStreak>3</maxStreak>
          <!-- Waga powsciagliwosci: ile cisza zawdziecza temu, ze ostatnio
               dzialo sie duzo. -->
          <weightRestraint>0.75</weightRestraint>
          <!-- Waga czynnika stalego = bazowa sklonnosc do ciszy. Przy sumie wag
               rownej 1.0 czyta sie wprost jako PODLOGA uzytecznosci PASS (0.25),
               czyli wartosc ciszy przy zupelnie pustej historii. -->
          <weightBaseline>0.25</weightBaseline>
          <!-- 0 do konca kroku 3, jak intentAlignment po stronie zdarzen. -->
          <weightIntentAlignment>0</weightIntentAlignment>
        </pass>
      </li>

      <!-- ============ PONIZEJ: skopiowane z Cassandry bez zmian ============ -->

      <!-- Intro -->
      <li Class="StorytellerCompProperties_ClassicIntro"/>

      <!-- Zagrozenia na mapach questowych typu raid beacon.
           To osobny tor od naszego (inny tag celu), wiec go nie ruszamy -
           bez niego questy obronne przestaja dzialac. -->
      <li Class="StorytellerCompProperties_ThreatsGenerator">
        <allowedTargetTags>
          <li>Map_RaidBeacon</li>
        </allowedTargetTags>
        <parms>
          <allowedThreats>Raids</allowedThreats>
          <onDays>1.0</onDays>
          <offDays>0.5</offDays>
          <minSpacingDays>0.04</minSpacingDays>
          <numIncidentsRange>1~2</numIncidentsRange>
          <minThreatPoints>500</minThreatPoints>
        </parms>
      </li>

      <li Class="StorytellerCompProperties_ShipChunkDrop"/>

      <!-- Choroby -->
      <li Class="StorytellerCompProperties_Disease">
        <category>DiseaseHuman</category>
        <minDaysPassed>9</minDaysPassed>
      </li>
      <li Class="StorytellerCompProperties_Disease">
        <category>DiseaseAnimal</category>
        <minDaysPassed>9</minDaysPassed>
      </li>

      <!-- Interakcje z frakcjami: sojusznicy, handlarze, goscie, podroznicy.
           BEZ TEGO KOLONIA NIE MA KOMU NIC SPRZEDAC. -->
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>RaidFriendly</incident>
        <baseIncidentsPerYear>15</baseIncidentsPerYear>
        <minSpacingDays>0.4</minSpacingDays>
        <fullAlliesOnly>true</fullAlliesOnly>
        <minDanger>High</minDanger>
      </li>
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>TraderCaravanArrival</incident>
        <minDaysPassed>5</minDaysPassed>
        <baseIncidentsPerYear>5</baseIncidentsPerYear>
        <minSpacingDays>6</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>VisitorGroup</incident>
        <minDaysPassed>3</minDaysPassed>
        <baseIncidentsPerYear>4</baseIncidentsPerYear>
        <minSpacingDays>5</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_FactionInteraction">
        <incident>TravelerGroup</incident>
        <minDaysPassed>1</minDaysPassed>
        <baseIncidentsPerYear>6</baseIncidentsPerYear>
        <minSpacingDays>1</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>

      <!-- Karawany i mapy tymczasowe (poza naszym torem) -->
      <li Class="StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>Misc</category>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>ThreatSmall</category>
        <applyCaravanVisibility>true</applyCaravanVisibility>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>
      <li Class="StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>ThreatBig</category>
        <applyCaravanVisibility>true</applyCaravanVisibility>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>

      <!-- Questy - wersja bez Royalty -->
      <li Class="StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <onDays>10</onDays>
        <numIncidentsRange>1</numIncidentsRange>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(15, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
        <minSpacingDays>3</minSpacingDays>
        <disableIfAnyModActive>
          <li>Ludeon.RimWorld.Royalty</li>
        </disableIfAnyModActive>
      </li>

      <!-- Questy - wersja z Royalty -->
      <li Class="StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <onDays>12</onDays>
        <numIncidentsRange>2</numIncidentsRange>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(15, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
        <minSpacingDays>3</minSpacingDays>
        <enableIfAnyModActive>
          <li>Ludeon.RimWorld.Royalty</li>
        </enableIfAnyModActive>
      </li>

      <!-- Wydarzenia swiatowe -->
      <li Class="StorytellerCompProperties_CategoryMTB">
        <category>Misc</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <minDaysPassed>15</minDaysPassed>
        <mtbDays>15</mtbDays>
      </li>

      <!-- Handlarz orbitalny -->
      <li Class="StorytellerCompProperties_OnOffCycle">
        <incident>OrbitalTraderArrival</incident>
        <onDays>7</onDays>
        <offDays>8</offDays>
        <numIncidentsRange>1</numIncidentsRange>
      </li>

      <!-- Wyzwalane -->
      <li Class="StorytellerCompProperties_Triggered">
        <incident>StrangerInBlackJoin</incident>
        <delayTicks>180</delayTicks>
      </li>

    </comps>
  </StorytellerDef>

</Defs>
