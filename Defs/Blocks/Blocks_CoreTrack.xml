  <!-- ============================== POGODA I WARUNKI GRY ============================== -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Mroz</defName>
    <blockType>Action</blockType>
    <theme>Natural</theme>
    <valence>Negative</valence>
    <scale>Moderate</scale>
    <intensity>Normal</intensity>
    <tags><li>pogoda</li><li>zimno</li></tags>
    <payload>ColdSnap</payload>
    <styleWeights><gospodarka>1</gospodarka></styleWeights>
    <!-- Prawda: sezonowo 0-15 C minus 20 C daje mroz; gra obniza temperature w ok. 5 h (12000 tickow). -->
    <textFragment>sprowadza na okolice nagly mroz.</textFragment>
    <textVariants>
      <li>
        <id>z1</id>
        <text>przynosi fale mrozu.</text>
      </li>
    </textVariants>
    <!-- IncidentWorker_ColdSnap: 0 < SeasonalTemp < 15; IncidentWorker_MakeGameCondition: ten sam warunek nie trwa
         (mapa i swiat), a zaden warunek NA MAPIE nie wyklucza fali mrozu (ColdSnap.exclusiveConditions = HeatWave). -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_SeasonalTemp">
        <greaterThan>0</greaterThan>
        <lessThan>15</lessThan>
      </li>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_GameConditionAbsent">
        <defs><li>ColdSnap</li></defs>
      </li>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_GameConditionAbsent">
        <defs><li>HeatWave</li></defs>
        <mapOnly>true</mapOnly>
      </li>
    </conditions>
    <onlyWith>
      <li>PN_Aktor_Natura</li>
      <li>PN_Kons_Pogoda</li>
    </onlyWith>
    <incompatibleWith>
      <li>PN_Trig_Bogactwo</li>
    </incompatibleWith>
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Season">
        <season>2</season>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Upal</defName>
