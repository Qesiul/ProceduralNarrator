    <textFragment>sprawia, ze z nieba zaczyna padac toksyczny pyl.</textFragment>
    <textVariants>
      <li>
        <id>z1</id>
        <text>zsyla na okolice toksyczny opad.</text>
      </li>
    </textVariants>
    <!-- Dzien 60, trudnosc z pogoda ekstremalna i odstep 90 dni sprawdza lustro gry (K0). -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_GameConditionAbsent">
        <defs><li>ToxicFallout</li></defs>
      </li>
    </conditions>
    <onlyWith>
      <li>PN_Aktor_Nieznane</li>
      <li>PN_Kons_Pogoda</li>
      <li>PN_Kons_ZnakNaNiebie</li>
    </onlyWith>
    <incompatibleWith>
      <li>PN_Trig_Bogactwo</li>
    </incompatibleWith>
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>60</from>
        <to>120</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
