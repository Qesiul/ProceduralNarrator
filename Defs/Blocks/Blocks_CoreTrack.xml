  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_SzalStada</defName>
    <blockType>Action</blockType>
    <theme>Natural</theme>
    <valence>Negative</valence>
    <scale>Major</scale>
    <intensity>High</intensity>
    <tags><li>militarny</li><li>zwierzeta</li><li>nagle</li></tags>
    <payload>AnimalInsanityMass</payload>
    <anomalyGate>Regular</anomalyGate>
    <scalesWithPoints>true</scalesWithPoints>
    <styleWeights><walka>1</walka><reaktywnosc>0.5</reaktywnosc></styleWeights>
    <!-- Gra nazywa to fala psychiczna (list "Some sort of psychic wave"). Bez "calego stada": przy malej liczbie punktow
         w szal wpada jedno zwierze. -->
    <textFragment>traci rozum pod wplywem psychicznej fali.</textFragment>
    <textVariants>
      <li>
        <id>z1</id>
        <text>wpada w szal, porazona psychiczna fala.</text>
      </li>
    </textVariants>
    <conditions>
      <!-- Gra sprawdza stado dopiero przy wykonaniu (TryExecuteWorker): gatunek z co najmniej 3 zdrowymi dzikimi
           osobnikami, combatPower nie wiekszy niz punkty po korekcie. pointsFactor 1.35 = maksymalny mnoznik
           intensywnosci (IntensityTable, VeryHigh) - sito zgrubne jak Cond_MinThreatPoints 296 = 400 / 1.35. -->
      <li Class="ProceduralNarrator.Core.Conditions.Cond_WildHerd">
        <pointsFactor>1.35</pointsFactor>
      </li>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinDaysPassed">
        <min>11</min>
      </li>
    </conditions>
    <onlyWith>
      <li>PN_Aktor_Dzikie</li>
      <li>PN_Kons_SladWalki</li>
      <li>PN_Kons_Trofea</li>
    </onlyWith>
    <incompatibleWith>
      <li>PN_Trig_Bogactwo</li>
    </incompatibleWith>
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WildAnimals">
        <from>5</from>
        <to>30</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

