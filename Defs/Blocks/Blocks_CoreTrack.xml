    <textFragment>zasnuwa niebo gestym popiolem.</textFragment>
    <textVariants>
      <li>
        <id>dzien</id>
        <conditions>
          <li Class="ProceduralNarrator.Core.Conditions.Cond_Night"><wantNight>false</wantNight></li>
