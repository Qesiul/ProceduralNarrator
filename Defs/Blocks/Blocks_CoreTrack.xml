  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Defoliator</defName>
    <blockType>Action</blockType>
    <!-- Decyzja autora K1-d: os Military ("sprawy zbrojne bez ataku") - mechanoidy strzega wraku i nie atakuja. -->
    <theme>Military</theme>
    <valence>Negative</valence>
    <scale>Major</scale>
    <intensity>High</intensity>
    <tags><li>militarny</li><li>wrak</li><li>niebo</li><li>mechanoidy</li><li>niszczy</li></tags>
    <payload>DefoliatorShipPartCrash</payload>
    <anomalyGate>Regular</anomalyGate>
    <scalesWithPoints>true</scalesWithPoints>
    <styleWeights><walka>1</walka></styleWeights>
    <!-- Prawda: wrak zabija rosliny w rosnacym promieniu. O mechanoidach tekst milczy - sa uspione, walka niepewna. -->
    <textFragment>zrzuca w okolicy wrak, wokol ktorego obumieraja rosliny.</textFragment>
    <textVariants>
      <li>
        <id>z1</id>
        <text>roztrzaskuje w okolicy wrak, ktory zabija rosliny wokol siebie.</text>
      </li>
    </textVariants>
    <!-- IncidentWorker_CrashedShipPart: frakcja mechanoidow, brak innego defoliatora na mapie; minThreatPoints 400
         (sito zgrubne 296 = 400 / 1.35, dokladne w IncidentParmsBuilder). Wspolny 15-dniowy odstep z Emanatorem
         (refireCheckTags MechanoidShip) sprawdza lustro gry. Prog dnia 11: parytet z Cassandra. -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MechanoidFaction" />
      <li Class="ProceduralNarrator.Core.Conditions.Cond_ThingCount">
        <thing>DefoliatorShipPart</thing>
        <max>0</max>
      </li>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinThreatPoints">
        <min>296</min>
      </li>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinDaysPassed">
        <min>11</min>
      </li>
    </conditions>
    <onlyWith>
      <li>PN_Aktor_Maszyny</li>
      <li>PN_Aktor_Nieznane</li>
      <li>PN_Kons_ZnakNaNiebie</li>
      <li>PN_Kons_Straty</li>
    </onlyWith>
    <incompatibleWith>
      <li>PN_Trig_Bogactwo</li>
    </incompatibleWith>
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>11</from>
        <to>90</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

</Defs>
