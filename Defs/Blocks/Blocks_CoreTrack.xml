    <!-- Prawda: sezonowo co najmniej 20 C plus 17 C daje co najmniej 37 C. -->
    <textFragment>sprowadza na okolice fale upalow.</textFragment>
    <textVariants>
      <li>
        <id>z1</id>
        <text>rozpala okolice upalem.</text>
      </li>
