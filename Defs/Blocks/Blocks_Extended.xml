<Defs>

  <!--
    ROZSZERZENIE KATALOGU - przygotowanie pod utility AI (krok 3).

    Cel jest waski i konkretny: dac scoringowi na czym roznicowac. Czynnik
    "swiezosc typu" nie ma czego mierzyc, gdy na temat przypada jedna akcja -
    narrator moze wtedy tylko przeskakiwac miedzy tematami, zamiast wybierac
    inny sposob realizacji tego samego tematu.

    Rozklad akcji na tematy (13 akcji, stan po dodaniu PN_Akcja_Amok):
        Raid 1 | Military 1 | Economic 3 | Social 3 | Natural 4 | Supernatural 1
        Trade 0, Disease 0  <- tory oddane vanilli, celowo puste
    UWAGA: tej liczby NIE PILNUJE zadna asercja - walidator sprawdza liczbe akcji (13)
    i przestrzen kombinacji (80), ale nie rozklad na tematy. Zestarzala sie juz raz
    (mowila "Natural 3" przy czterech) i zestarzeje sie znowu, jesli ktos dosypie
    akcje i nie poprawi tej linijki.

    Raid zostaje przy jednej akcji, bo w Core nie ma drugiego incydentu bedacego
    bezposrednim szturmem na kolonie. Warianty oblezenia to RaidStrategyDef
    przekazywany w IncidentParms, a nie osobny IncidentDef - wejscie w nie wymaga
    rozszerzenia semantyki pola payload i jest robota na pozniej.

    Wszystkie payloady pochodza z Core - zero zaleznosci od DLC.
  -->

  <!-- ============================== AKTORZY ==============================
       Slot Actor jest wymagany przez kompozytora, a zdarzenia pogodowe
       i nadprzyrodzone nie maja sprawcy wsrod pierwotnej trojki.
       Oba w liczbie POJEDYNCZEJ - fragmenty akcji sa pisane pod trzecia
       osobe liczby pojedynczej ("uderza", "prosi", "zrzuca").              -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Aktor_Natura</defName>
    <blockType>Actor</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>Normal</intensity>
    <tags><li>zywioly</li><li>bezosobowy</li></tags>
    <textFragment>Natura</textFragment>
    <!-- Para przeciwstawna z PN_Aktor_Nieznane (tamten rosnie 10->90): zwyczajne sily przyrody
         sa tlem wczesnej rozgrywki, a dziwnosc narasta z czasem. Bez wlasnej preferencji Natura
         byla jedynym aktorem wolnym od kary i wygrywala slot samym brakiem zdania. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>90</from>
        <to>10</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Aktor_Nieznane</defName>
    <blockType>Actor</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>High</intensity>
    <tags><li>nadprzyrodzony</li><li>bezosobowy</li></tags>
    <textFragment>Cos nieznanego</textFragment>
    <!-- Dziwne rzeczy pasuja bardziej do dojrzalej rozgrywki -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>10</from>
        <to>90</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <!-- ================================ AKCJE ================================ -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Okup</defName>
    <blockType>Action</blockType>
    <theme>Military</theme>
    <valence>Negative</valence>
    <scale>Moderate</scale>
    <intensity>Normal</intensity>
    <tags><li>militarny</li><li>szantaz</li></tags>
    <payload>RansomDemand</payload>
    <textFragment>zada okupu za porwanego czlonka kolonii.</textFragment>
    <!-- REGULA "fakt w tekscie = warunek TWARDY". Fragment stwierdza, ze ktos ZOSTAL PORWANY -
         to sprawdzalny fakt o stanie swiata, wiec musi go pilnowac warunek, nie preferencja.
         Cond_KidnappedColonist odwzorowuje IncidentWorker_RansomDemand.RandomKidnappedColonist().
         Cond_PoweredCommsConsole nie dotyczy prawdziwosci tekstu, tylko WYKONALNOSCI: waniliowy
         worker wymaga zasilanej konsoli (CommsConsoleUtility.PlayerHasPoweredCommsConsole).
         Bez niego kompozycja produkowala kandydatow skazanych na odmowe CanFireNow i marnowala
         rundy petli wyboru - dokladnie ten sam blad, ktory naprawiono przy Cond_MountainRoof. -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_HostileFaction"/>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_KidnappedColonist">
        <min>1</min>
      </li>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_PoweredCommsConsole"/>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinDaysPassed">
        <min>5</min>
      </li>
    </conditions>
    <!-- Bogatszej kolonii oplaca sie stawiac wyzsze zadania -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>0.8</from>
        <to>4.0</to>
      </li>
    </preferences>
    <incompatibleWith>
      <li>PN_Aktor_Dzikie</li>
      <li>PN_Aktor_Obcy</li>
      <li>PN_Aktor_Natura</li>
      <li>PN_Aktor_Nieznane</li>
    </incompatibleWith>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

