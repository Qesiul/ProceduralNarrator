<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Katalog klockow (sekcja 5.8 koncepcji) - warstwa DANYCH.
    Dodanie wydarzenia = dopisanie klockow tutaj, bez dotykania kodu decyzyjnego.

    SCHEMAT (krok 2):
      blockType    slot: Trigger / Actor / Action / Target / Modifier / Consequence
      theme        os tematu (8 wartosci) - Raid to atak na kolonie,
                   Military to sprawy zbrojne BEZ ataku
      valence      Negative / Neutral / Positive
      scale        Minor / Moderate / Major
      intensity    Low / Normal / High - INTENCJA co do sily.
                   Na punkty incydentu tlumaczy ja IntensityTable w Integration,
                   zeby kalibracja zyla w jednym miejscu.
      conditions   TWARDE bramki - klocek niedostepny, gdy ktorakolwiek nie przejdzie.
                   Odpowiadaja za SPOJNOSC.
      preferences  MIEKKIE preferencje 0..1 - nie blokuja, skladaja sie na contextFit
                   gotowego kandydata. Odpowiadaja za KONTEKSTOWOSC.
      incompatibleWith  krawedzie grafu, deklarowane przy klocku AKCJI, zeby reguly
                   jednego wydarzenia byly w jednym miejscu.

    UWAGA: wezel musi miec PELNA nazwe typu z namespace'em - sama <NarrativeBlockDef>
    jest po cichu ignorowana przez DirectXmlLoader.

    Fragmenty tekstu skladaja sie w kolejnosci slotow:
        Trigger -> Actor -> Action -> Target -> Modifier
    Dlatego fragmenty celu i modyfikatora sa neutralne - musza brzmiec sensownie
    zarowno przy wydarzeniu negatywnym, jak i pozytywnym.
  -->

  <!-- ========================= WYZWALACZE (slot opcjonalny) ========================= -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Trig_Bogactwo</defName>
    <blockType>Trigger</blockType>
    <theme>Economic</theme>
    <valence>Neutral</valence>
    <scale>Minor</scale>
    <intensity>High</intensity>
    <tags><li>rozglos</li></tags>
    <textFragment>Wiesc o zamoznosci kolonii rozeszla sie po okolicy.</textFragment>
    <!-- Zeby wiesc o bogactwie mogla sie rozejsc, kolonia musi cos miec -->
    <!-- 2.0 = kolonia dwa razy bogatsza, niz gra sie spodziewa na tym etapie.
         Prog wzgledny, bo absolutny zalezy od scenariusza startowego. -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_WealthRelative">
        <min>2.0</min>
      </li>
    </conditions>
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>2.0</from>
        <to>6.0</to>
        <weight>2</weight>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Trig_Cisza</defName>
    <blockType>Trigger</blockType>
    <theme>Natural</theme>
    <valence>Neutral</valence>
    <scale>Minor</scale>
    <intensity>Normal</intensity>
    <tags><li>spokoj</li></tags>
    <textFragment>Po dniach spokoju cos w koncu zaklocilo rutyne.</textFragment>
    <!-- Ten fragment stwierdza, ze BYL spokoj - a tego wczesniej nikt nie sprawdzal.
         Gdy poprzednie wydarzenie wypadlo dzien wczesniej, zdanie bylo po prostu nieprawdziwe.
         1.5 dnia przy mtbDays=2.5 odsiewa nastepstwa "tuz po sobie", zostawiajac typowe odstepy. -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_CalmPeriod">
        <minDays>1.5</minDays>
      </li>
    </conditions>
    <!-- Para przeciwstawna z PN_Trig_Bogactwo: tamten wymaga kolonii dwa razy zamozniejszej
         od normy, ten pasuje do kolonii zwyczajnej. Bez wlasnej preferencji "cisza" wygrywala
         z "bogactwem" samym brakiem kary, gdy tylko bogactwo przekroczylo prog. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>2.0</from>
        <to>0.5</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <!-- ================================ AKTORZY ================================ -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Aktor_Piraci</defName>
    <blockType>Actor</blockType>
    <theme>Raid</theme>
    <valence>Negative</valence>
    <scale>Moderate</scale>
    <intensity>High</intensity>
    <tags><li>wrogi</li><li>ludzki</li></tags>
    <textFragment>Banda piratow</textFragment>
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_HostileFaction"/>
    </conditions>
    <!-- Piratow przyciaga bogactwo i slabo broniona kolonia -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>0.8</from>
        <to>4.0</to>
        <weight>2</weight>
      </li>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>10</from>
        <to>2</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Aktor_Dzikie</defName>
    <blockType>Actor</blockType>
    <theme>Natural</theme>
    <valence>Negative</valence>
    <scale>Moderate</scale>
    <intensity>Normal</intensity>
    <tags><li>zwierzeta</li></tags>
    <textFragment>Dzika zwierzyna</textFragment>
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_WildAnimals">
        <min>1</min>
      </li>
    </conditions>
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WildAnimals">
        <from>2</from>
        <to>30</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Aktor_Obcy</defName>
    <blockType>Actor</blockType>
    <theme>Social</theme>
    <valence>Neutral</valence>
    <scale>Minor</scale>
    <intensity>Normal</intensity>
    <tags><li>neutralny</li><li>ludzki</li></tags>
    <textFragment>Ktos z zewnatrz</textFragment>
    <!-- Wedrowcy trafiaja raczej do kolonii, ktora zdazyla zaistniec -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>0</from>
        <to>30</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <!-- ================================= AKCJE =================================
       payload = defName incydentu RimWorlda, ktory realizuje ten klocek        -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Napad</defName>
    <blockType>Action</blockType>
    <theme>Raid</theme>
    <valence>Negative</valence>
    <scale>Major</scale>
    <intensity>Normal</intensity>
    <tags><li>militarny</li></tags>
    <payload>RaidEnemy</payload>
    <textFragment>uderza na kolonie zbrojnie.</textFragment>
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_HostileFaction"/>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinDaysPassed">
        <min>5</min>
      </li>
    </conditions>
    <!-- Zbrojny napad prowadzi tylko wrogi oddzial ludzi -->
    <incompatibleWith>
      <li>PN_Aktor_Dzikie</li>
      <li>PN_Aktor_Obcy</li>
      <li>PN_Aktor_Natura</li>
      <li>PN_Aktor_Nieznane</li>
    </incompatibleWith>
    <!-- Napady rosna z dojrzaloscia kolonii - ten sam kierunek, w ktorym vanilla skaluje
         zagrozenie przez pointsFactorFromDaysPassed. Bez wlasnej preferencji caly contextFit
         napadu pochodzil od klocka aktora, przez co napad przegrywal z wydarzeniami, ktore
         mialy sufit 1.0 za darmo. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>0</from>
        <to>45</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Szal</defName>
    <blockType>Action</blockType>
    <theme>Natural</theme>
    <valence>Negative</valence>
    <scale>Moderate</scale>
    <intensity>Low</intensity>
    <tags><li>militarny</li><li>zwierzeta</li></tags>
    <payload>ManhunterPack</payload>
    <textFragment>wpada w szal i rusza na osade.</textFragment>
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_WildAnimals">
        <min>1</min>
      </li>
    </conditions>
    <!-- W szal wpadaja zwierzeta, nie ludzie; bogactwo kolonii nie ma tu nic do rzeczy -->
    <incompatibleWith>
      <li>PN_Aktor_Piraci</li>
      <li>PN_Aktor_Obcy</li>
      <li>PN_Trig_Bogactwo</li>
      <li>PN_Aktor_Natura</li>
      <li>PN_Aktor_Nieznane</li>
    </incompatibleWith>
    <!-- Zwierzeta atakuja czlowieka, gdy brakuje zeru - zima jest po temu najlepsza pora. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Season">
        <season>3</season>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Rojenie</defName>
    <blockType>Action</blockType>
    <theme>Natural</theme>
    <valence>Negative</valence>
    <scale>Major</scale>
    <intensity>High</intensity>
    <tags><li>militarny</li><li>insekty</li></tags>
    <payload>Infestation</payload>
    <textFragment>wygryza sie spod podlogi.</textFragment>
    <!-- Twardy warunek, ktory wczesniej odbijal sie od CanFireNow -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MountainRoof"/>
    </conditions>
    <incompatibleWith>
      <li>PN_Aktor_Piraci</li>
      <li>PN_Aktor_Obcy</li>
      <li>PN_Trig_Bogactwo</li>
      <li>PN_Aktor_Natura</li>
    </incompatibleWith>
    <!-- Infestacja to zagrozenie fazy sredniej i poznej: zanim kolonia rozbuduje sie pod gora,
         nie ma czego atakowac. Warunek twardy pilnuje stropu, preferencja - dojrzalosci. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>10</from>
        <to>60</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Wedrowiec</defName>
    <blockType>Action</blockType>
    <theme>Social</theme>
    <valence>Positive</valence>
    <scale>Minor</scale>
    <intensity>Low</intensity>
    <tags><li>spoleczny</li></tags>
    <payload>WandererJoin</payload>
    <textFragment>prosi o przyjecie do kolonii.</textFragment>
    <!-- Male kolonie bardziej potrzebuja rak do pracy -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>12</from>
        <to>3</to>
      </li>
    </preferences>
    <!-- O przyjecie prosi czlowiek z zewnatrz, nie piraci i nie zwierze -->
    <incompatibleWith>
      <li>PN_Aktor_Piraci</li>
      <li>PN_Aktor_Dzikie</li>
      <li>PN_Aktor_Natura</li>
      <li>PN_Aktor_Nieznane</li>
    </incompatibleWith>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Zrzut</defName>
    <blockType>Action</blockType>
    <theme>Economic</theme>
    <valence>Positive</valence>
    <scale>Minor</scale>
    <intensity>Low</intensity>
    <tags><li>zasoby</li></tags>
    <payload>ResourcePodCrash</payload>
    <textFragment>zostawia po sobie rozbita kapsule z zaopatrzeniem.</textFragment>
    <!-- Uboga kolonia bardziej potrzebuje zaopatrzenia -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>2.5</from>
        <to>0.4</to>
      </li>
    </preferences>
    <incompatibleWith>
      <li>PN_Aktor_Piraci</li>
      <li>PN_Aktor_Dzikie</li>
      <li>PN_Aktor_Nieznane</li>
    </incompatibleWith>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <!-- ================================== CELE ================================== -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Cel_Osada</defName>
    <blockType>Target</blockType>
    <theme>Natural</theme>
    <valence>Neutral</valence>
    <scale>Moderate</scale>
    <intensity>Normal</intensity>
    <tags><li>kolonia</li></tags>
    <!-- FRAGMENT PRZEPISANY. Poprzednia wersja stwierdzala, GDZIE dzieje sie zdarzenie -
         a tego nie kontrolujemy: IncidentWorker sam wybiera miejsce, wiec zdanie bywalo
         falszywe i zadnym warunkiem twardym nie dalo sie tego naprawic. Nowa wersja mowi
         o WADZE sprawy, ktora ten klocek faktycznie koduje (scale + intensity), wiec jest
         prawdziwa z konstrukcji. Dopoki slot Target nie parametryzuje IncidentParms,
         nie wolno mu obiecywac polozenia. -->
    <textFragment>Dla kolonii to sprawa pierwszej wagi.</textFragment>
    <!-- "Serce osady" ma sens, gdy osada ma serce: rozwinieta kolonia ma gesty rdzen,
         w ktory da sie uderzyc. Para przeciwstawna z PN_Cel_Obrzeza - bez tego jeden z celow
         nie mial ZADNEJ preferencji i wygrywal remis samym brakiem kary. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>2</from>
        <to>10</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Cel_Obrzeza</defName>
    <blockType>Target</blockType>
    <theme>Natural</theme>
    <valence>Neutral</valence>
    <scale>Minor</scale>
    <intensity>Low</intensity>
    <tags><li>kolonia</li><li>peryferia</li></tags>
    <!-- FRAGMENT PRZEPISANY. Poprzednia wersja stwierdzala, GDZIE dzieje sie zdarzenie -
         a tego nie kontrolujemy: IncidentWorker sam wybiera miejsce, wiec zdanie bywalo
         falszywe i zadnym warunkiem twardym nie dalo sie tego naprawic. Nowa wersja mowi
         o WADZE sprawy, ktora ten klocek faktycznie koduje (scale + intensity), wiec jest
         prawdziwa z konstrukcji. Dopoki slot Target nie parametryzuje IncidentParms,
         nie wolno mu obiecywac polozenia. -->
    <textFragment>Dla kolonii to na razie sprawa drugorzedna.</textFragment>
    <!-- Mala kolonia to jeszcze nie osada z centrum - jej zycie toczy sie na obrzezach.
         Rampa MALEJACA, przeciwstawna do PN_Cel_Osada. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>10</from>
        <to>2</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <!-- ========================= MODYFIKATORY (slot opcjonalny) ========================= -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Mod_Noc</defName>
    <blockType>Modifier</blockType>
    <theme>Natural</theme>
    <valence>Neutral</valence>
    <scale>Minor</scale>
    <intensity>High</intensity>
    <tags><li>czas</li></tags>
    <textFragment>Wszystko rozgrywa sie po zmroku.</textFragment>
    <!-- REGULA: fragment STWIERDZAJACY sprawdzalny fakt musi miec go jako warunek TWARDY.
         Zmierzone w grze: przy samej preferencji softmax wybral ten klocek w biale poludnie
         (noc=False) i narrator napisal "po zmroku" - kompozycja formalnie poprawna, tekst
         falszywy. Preferencja mowi "to tu pasuje", nie "to jest prawda".
         Preferencja ZOSTAJE obok warunku: warunek dopuszcza, preferencja stopniuje. -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_Night"/>
    </conditions>
    <!-- Nie blokuje, ale opis o zmroku pasuje duzo lepiej faktycznie noca -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Night">
        <wantNight>true</wantNight>
        <!-- Bylo 3. Modyfikator jest SZCZEGOLEM zdarzenia, wiec nie moze dominowac
             contextFit nad wlasnym dopasowaniem akcji: przy wadze 3 wartosc 0.20 w dzien
             sciagala caly wynik kandydata i w praktyce wykluczala warianty nocne poza noca,
             a w nocy je narzucala. 1.5 zostawia wyrazny wplyw bez przejmowania sterowania. -->
        <weight>1.5</weight>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Mod_Slabo</defName>
    <blockType>Modifier</blockType>
    <theme>Natural</theme>
    <valence>Neutral</valence>
    <scale>Minor</scale>
    <intensity>Low</intensity>
    <tags><li>skala</li></tags>
    <!-- FRAGMENT PRZEPISANY. "Skala OKAZUJE SIE mniejsza" stwierdzalo o WYNIKU zlozenia,
         a ten klocek wnosi tylko -1 do intensywnosci - suma z pozostalymi slotami potrafi
         wyjsc Normal albo wyzej i zdanie bylo wtedy nieprawdziwe. Nowa wersja mowi o WKLADZIE
         tego klocka, ktory jest pewny. Prawdziwe rozwiazanie to warianty tekstu zalezne od
         KONCOWEJ intensywnosci (sekcja 5.7 koncepcji) - do zrobienia przy podmianie listu. -->
    <textFragment>Rozmach jest mniejszy, niz moglby byc.</textFragment>
    <!-- ZNALEZISKO Z ROZGRYWKI: ten klocek nie mial zadnej preferencji, wiec nigdy nie byl
         karany, podczas gdy PN_Mod_Noc w ciagu dnia dostawal 0.20. Skutek: trzy pierwsze
         decyzje z rzedu wybraly "Skala zdarzenia okazuje sie mniejsza..." i opisy zaczely sie
         powtarzac. Preferencja domyka te asymetrie: zlagodzenie ma sens wobec malej kolonii,
         ktora i tak ledwo daje rade - to odpowiednik waniliowej krzywej adaptacji. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>10</from>
        <to>2</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

</Defs>
