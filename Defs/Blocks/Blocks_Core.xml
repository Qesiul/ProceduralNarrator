  <!-- ================================= AKCJE =================================
       payload = defName incydentu RimWorlda, ktory realizuje ten klocek        -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Napad</defName>
    <blockType>Action</blockType>
    <theme>Raid</theme>
    <valence>Negative</valence>
    <scale>Major</scale>
    <intensity>Normal</intensity>
    <tags><li>militarny</li></tags>
    <payload>RaidEnemy</payload>
    <!-- BEZ slowa "zbrojnie": jedyny dozwolony aktor to PN_Aktor_Piraci, ktory po audycie
         etapu 3 mowi "Wroga grupa zbrojna" - zlozone zdanie brzmialo "Wroga grupa zbrojna
         uderza na kolonie zbrojnie". Zapamietac: przepisanie tekstu JEDNEGO klocka moze
         zepsuc zdanie skladane z INNYM klockiem, a widac to dopiero w zlozonym opisie. -->
    <textFragment>uderza na kolonie.</textFragment>
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_HostileFaction"/>
      <!-- 11, nie 5: odwzorowuje OnOffCycle(ThreatBig) u Cassandry. Comp ma prog 5 (tor Misc,
           8 z 12 akcji), wiec wyzszy prog zagrozen musi byc na poziomie akcji. -->
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinDaysPassed">
        <min>11</min>
      </li>
    </conditions>
    <!-- Zbrojny napad prowadzi tylko wrogi oddzial ludzi -->
    <incompatibleWith>
      <li>PN_Aktor_Dzikie</li>
      <li>PN_Aktor_Obcy</li>
      <li>PN_Aktor_Natura</li>
      <li>PN_Aktor_Nieznane</li>
    </incompatibleWith>
    <!-- Napady rosna z dojrzaloscia kolonii - ten sam kierunek, w ktorym vanilla skaluje
         zagrozenie przez pointsFactorFromDaysPassed. Bez wlasnej preferencji caly contextFit
         napadu pochodzil od klocka aktora, przez co napad przegrywal z wydarzeniami, ktore
         mialy sufit 1.0 za darmo. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>0</from>
        <to>45</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Szal</defName>
    <blockType>Action</blockType>
    <theme>Natural</theme>
    <valence>Negative</valence>
    <scale>Moderate</scale>
    <intensity>Low</intensity>
    <tags><li>militarny</li><li>zwierzeta</li></tags>
    <payload>ManhunterPack</payload>
    <textFragment>wpada w szal i rusza na osade.</textFragment>
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_WildAnimals">
        <min>1</min>
      </li>
      <!-- Prog 11 dnia odwzorowuje minDaysPassed podmienianego compa OnOffCycle(ThreatBig)
           u Cassandry. Comp ma prog 5 (tor Misc, 8 z 12 akcji), wiec wyzszy prog dla zagrozen
           musi siedziec TUTAJ - inaczej narrator wypuszczalby duze zagrozenia wczesniej
           niz narrator, z ktorym sie porownujemy. -->
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinDaysPassed">
        <min>11</min>
      </li>
    </conditions>
    <!-- W szal wpadaja zwierzeta, nie ludzie; bogactwo kolonii nie ma tu nic do rzeczy -->
    <incompatibleWith>
      <li>PN_Aktor_Piraci</li>
      <li>PN_Aktor_Obcy</li>
      <li>PN_Trig_Bogactwo</li>
      <li>PN_Aktor_Natura</li>
      <li>PN_Aktor_Nieznane</li>
    </incompatibleWith>
    <!-- Zwierzeta atakuja czlowieka, gdy brakuje zeru - zima jest po temu najlepsza pora. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Season">
        <season>3</season>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Rojenie</defName>
    <blockType>Action</blockType>
    <theme>Natural</theme>
    <valence>Negative</valence>
    <scale>Major</scale>
    <intensity>High</intensity>
    <tags><li>militarny</li><li>insekty</li></tags>
    <payload>Infestation</payload>
    <textFragment>wygryza sie spod podlogi.</textFragment>
    <!-- Twardy warunek, ktory wczesniej odbijal sie od CanFireNow -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MountainRoof"/>
      <!-- Prog 11 dnia odwzorowuje minDaysPassed podmienianego compa OnOffCycle(ThreatBig)
           u Cassandry. Comp ma prog 5 (tor Misc, 8 z 12 akcji), wiec wyzszy prog dla zagrozen
           musi siedziec TUTAJ - inaczej narrator wypuszczalby duze zagrozenia wczesniej
           niz narrator, z ktorym sie porownujemy. -->
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinDaysPassed">
        <min>11</min>
      </li>
      <!-- SITO ZGRUBNE progu punktow zagrozenia (nie nasza kalibracja trudnosci).
           Waniliowy Infestation wymaga 400 punktow, a bazowy IncidentWorker.CanFireNow
           odrzuca kandydata ponizej tego progu. Swieza kolonia ma okolo 35-70 punktow,
           wiec bez tego warunku klocek jest praktycznie niemozliwy do odpalenia -
           a mimo to wygrywa rundy wyboru.
           Tutaj luka byla ZAMASKOWANA: Cond_MountainRoof odrzucal rojenie wczesniej, wiec
           nie marnowalo rund w swiezej kolonii. W kolonii gorskiej, ale ubogiej, ujawnilaby sie
           dokladnie tak jak przy emanatorze.

           PROG PODZIELONY PRZEZ MAKSYMALNY MNOZNIK INTENSYWNOSCI: 400 / 1.35 = 296.
           Gra porownuje z minThreatPoints punkty JUZ PRZEMNOZONE przez intensywnosc GOTOWEJ
           kompozycji, a ten warunek dziala na poziomie KLOCKA i tej intensywnosci nie zna -
           sumuje sie ona z wszystkich piecu slotow. Prog rowny 400 produkowal falszywe
           negatywy: przy bazie 350 i kompozycji VeryHigh gra widzi 472 i przepuszcza,
           a warunek blokowal. Taka strata jest NIEWIDOCZNA W ZADNYM LOGU, bo kandydat
           w ogole nie powstaje.
           Sprawdzenie DOKLADNE robi IncidentParmsBuilder.OdfiltrujNieosiagalne na gotowych
           kandydatach, przed scoringiem. Tu jest tylko tanie sito zgrubne. -->
      <li Class="ProceduralNarrator.Core.Conditions.Cond_MinThreatPoints">
        <min>296</min>
      </li>
    </conditions>
    <incompatibleWith>
      <li>PN_Aktor_Piraci</li>
      <li>PN_Aktor_Obcy</li>
      <li>PN_Trig_Bogactwo</li>
      <li>PN_Aktor_Natura</li>
    </incompatibleWith>
    <!-- Infestacja to zagrozenie fazy sredniej i poznej: zanim kolonia rozbuduje sie pod gora,
         nie ma czego atakowac. Warunek twardy pilnuje stropu, preferencja - dojrzalosci. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_GameAge">
        <from>10</from>
        <to>60</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Wedrowiec</defName>
    <blockType>Action</blockType>
    <theme>Social</theme>
    <valence>Positive</valence>
    <scale>Minor</scale>
    <intensity>Low</intensity>
    <tags><li>spoleczny</li></tags>
    <payload>WandererJoin</payload>
    <textFragment>prosi o przyjecie do kolonii.</textFragment>
    <!-- Male kolonie bardziej potrzebuja rak do pracy -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>12</from>
        <to>3</to>
      </li>
    </preferences>
    <!-- O przyjecie prosi czlowiek z zewnatrz, nie piraci i nie zwierze -->
    <incompatibleWith>
      <li>PN_Aktor_Piraci</li>
      <li>PN_Aktor_Dzikie</li>
      <li>PN_Aktor_Natura</li>
      <li>PN_Aktor_Nieznane</li>
    </incompatibleWith>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Akcja_Zrzut</defName>
    <blockType>Action</blockType>
    <theme>Economic</theme>
    <valence>Positive</valence>
    <scale>Minor</scale>
    <intensity>Low</intensity>
    <tags><li>zasoby</li></tags>
    <payload>ResourcePodCrash</payload>
    <textFragment>zostawia po sobie rozbita kapsule z zaopatrzeniem.</textFragment>
    <!-- Uboga kolonia bardziej potrzebuje zaopatrzenia -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>2.5</from>
        <to>0.4</to>
      </li>
    </preferences>
    <incompatibleWith>
      <li>PN_Aktor_Piraci</li>
      <li>PN_Aktor_Dzikie</li>
      <li>PN_Aktor_Nieznane</li>
      <!-- Natura nie zostawia po sobie kapsul z zaopatrzeniem. Bez tej krawedzi powstawalo
           zdanie "Natura zostawia po sobie rozbita kapsule z zaopatrzeniem" - 8 z 84
           kandydatow. Meteoryt zostaje przy Naturze CELOWO: kruszec faktycznie spada z nieba
           sam z siebie, wiec tam atrybucja jest prawdziwa. -->
      <li>PN_Aktor_Natura</li>
    </incompatibleWith>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <!-- ================================== CELE ================================== -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Cel_Osada</defName>
    <blockType>Target</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>Normal</intensity>
    <tags><li>kolonia</li></tags>
    <!-- FRAGMENT PRZEPISANY. Poprzednia wersja stwierdzala, GDZIE dzieje sie zdarzenie -
         a tego nie kontrolujemy: IncidentWorker sam wybiera miejsce, wiec zdanie bywalo
         falszywe i zadnym warunkiem twardym nie dalo sie tego naprawic. Nowa wersja mowi
         o WADZE sprawy, ktora ten klocek faktycznie koduje (scale + intensity), wiec jest
         prawdziwa z konstrukcji. Dopoki slot Target nie parametryzuje IncidentParms,
         nie wolno mu obiecywac polozenia. -->
    <textFragment>Dla kolonii to sprawa pierwszej wagi.</textFragment>
    <!-- "Serce osady" ma sens, gdy osada ma serce: rozwinieta kolonia ma gesty rdzen,
         w ktory da sie uderzyc. Para przeciwstawna z PN_Cel_Obrzeza - bez tego jeden z celow
         nie mial ZADNEJ preferencji i wygrywal remis samym brakiem kary. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>2</from>
        <to>10</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Cel_Obrzeza</defName>
    <blockType>Target</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>Low</intensity>
    <tags><li>kolonia</li><li>peryferia</li></tags>
    <!-- FRAGMENT PRZEPISANY. Poprzednia wersja stwierdzala, GDZIE dzieje sie zdarzenie -
         a tego nie kontrolujemy: IncidentWorker sam wybiera miejsce, wiec zdanie bywalo
         falszywe i zadnym warunkiem twardym nie dalo sie tego naprawic. Nowa wersja mowi
         o WADZE sprawy, ktora ten klocek faktycznie koduje (scale + intensity), wiec jest
         prawdziwa z konstrukcji. Dopoki slot Target nie parametryzuje IncidentParms,
         nie wolno mu obiecywac polozenia. -->
    <textFragment>Dla kolonii to na razie sprawa drugorzedna.</textFragment>
    <!-- Mala kolonia to jeszcze nie osada z centrum - jej zycie toczy sie na obrzezach.
         Rampa MALEJACA, przeciwstawna do PN_Cel_Osada. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>10</from>
        <to>2</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <!-- ========================= MODYFIKATORY (slot opcjonalny) ========================= -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Mod_Noc</defName>
    <blockType>Modifier</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>High</intensity>
    <tags><li>czas</li></tags>
    <textFragment>Wszystko rozgrywa sie po zmroku.</textFragment>
    <!-- REGULA: fragment STWIERDZAJACY sprawdzalny fakt musi miec go jako warunek TWARDY.
         Zmierzone w grze: przy samej preferencji softmax wybral ten klocek w biale poludnie
         (noc=False) i narrator napisal "po zmroku" - kompozycja formalnie poprawna, tekst
         falszywy. Preferencja mowi "to tu pasuje", nie "to jest prawda".
         Preferencja ZOSTAJE obok warunku: warunek dopuszcza, preferencja stopniuje. -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_Night"/>
    </conditions>
    <!-- Nie blokuje, ale opis o zmroku pasuje duzo lepiej faktycznie noca -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Night">
        <wantNight>true</wantNight>
        <!-- Bylo 3. Modyfikator jest SZCZEGOLEM zdarzenia, wiec nie moze dominowac
             contextFit nad wlasnym dopasowaniem akcji: przy wadze 3 wartosc 0.20 w dzien
             sciagala caly wynik kandydata i w praktyce wykluczala warianty nocne poza noca,
             a w nocy je narzucala. 1.5 zostawia wyrazny wplyw bez przejmowania sterowania. -->
        <weight>1.5</weight>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Mod_Slabo</defName>
    <blockType>Modifier</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>Low</intensity>
    <tags><li>skala</li></tags>
    <!-- FRAGMENT PRZEPISANY. "Skala OKAZUJE SIE mniejsza" stwierdzalo o WYNIKU zlozenia,
         a ten klocek wnosi tylko -1 do intensywnosci - suma z pozostalymi slotami potrafi
         wyjsc Normal albo wyzej i zdanie bylo wtedy nieprawdziwe. Nowa wersja mowi o WKLADZIE
         tego klocka, ktory jest pewny. Prawdziwe rozwiazanie to warianty tekstu zalezne od
         KONCOWEJ intensywnosci (sekcja 5.7 koncepcji) - do zrobienia przy podmianie listu.

         ZAKRES, W JAKIM TEN KLOCEK DZIALA MECHANICZNIE - DWIE ROZNE MIARY, NIE JEDNA.
         Wklad -1 do intensywnosci przeklada sie na mnoznik punktow zagrozenia, ale punkty
         wplywaja na PRZEBIEG zdarzenia tylko u czesci katalogu.

         (A) ZMIERZONE DEKOMPILACJA - worker nie czyta parms.points ANI RAZU. Siedem akcji:
             Ambrozja/AmbrosiaSprout   Burza/Flashstorm      Dzikus/WildManWandersIn
             Meteoryt/MeteoriteImpact  Okup/RansomDemand     Zrzut/ResourcePodCrash
             Amok/AnimalInsanitySingle
             Przy nich ten klocek na pewno nie zmienia przebiegu zdarzenia. To 40 z 80 kandydatow.

         (B) WIDZIANE PRZEZ AUDYT STARTOWY - brak deklaracji pointsScaleable i progu punktowego.
             DZIEWIEC akcji, bo doliczaja sie Wedrowiec/WandererJoin i Uchodzcy/RefugeePodCrash.
             Audyt czyta DEKLARACJE z Defa, nie kod workera, wiec jego lista jest SZERSZA - i to
             jest poprawne zachowanie kontroli, ktora ma wskazywac miejsca do sprawdzenia.

         ROZJAZD MIEDZY (A) I (B) JEST REALNY I NIEROZSTRZYGNIETY: IncidentWorker_GiveQuest
         PRZEKAZUJE parms.points do generatora zadania, mimo ze Def deklaruje pointsScaleable
         = false. Czy zmienia to TRESC zadania - NIE ZBADANE. Do rozstrzygniecia przy kroku 8,
         jesli metryka intensywnosci ma byc liczona na tych dwoch akcjach.

         Przy akcjach z grupy (A) ten klocek nie zmienia PRZEBIEGU zdarzenia - jest ono
         identyczne z modyfikatorem i bez niego.

         ALE NIE JEST PRZEZ TO "BEZCZYNNY", i to jest sprostowanie wczesniejszego sformulowania:
         klocek wnosi dalej preferencje do contextFit oraz wlasna intensywnosc do intentAlignment,
         wiec realnie przesuwa ranking kandydatow. Bezczynny jest wylacznie kanal
         "punkty zagrozenia -> przebieg zdarzenia".

         STATUS TEKSTU: SPORNY, nie rozstrzygniety na korzysc. Argument za zostawieniem: zdanie
         porownuje z POTENCJALEM ("nizszy, niz moglby byc"), a nie z obserwowalna wielkoscia,
         wiec gracz nie ma kontrfaktu i nie ma jak go obalic - inaczej niz "Wszystko rozgrywa
         sie po zmroku", ktore obala jedno spojrzenie na niebo. Argument przeciw (sluszny):
         przy incydencie ignorujacym punkty sama etykieta VeryLow NICZEGO NIE GWARANTUJE, wiec
         "mniejszy rozmach" nie ma w grze zadnego desygnatu - zdanie nie tyle klamie, co mowi
         o niczym. Rozstrzygniecie nalezy do wariantow tekstu zaleznych od kontekstu
         (sekcja 5.7 koncepcji): dopiero one pozwola powiedziec "mniejszy rozmach" tam, gdzie
         to cos znaczy, i cos innego tam, gdzie nie znaczy. Do tego czasu tekst zostaje
         NIEZMIENIONY swiadomie - zmiana bez rozstrzygniecia byla by ruchem glosu narracyjnego
         bez zysku.

         DLACZEGO TEZ NIE ZAKAZUJEMY TYCH PAR. Modyfikator wnoszacy sam opis jest uprawniony;
         zakaz podmienilby regule "tekst ma byc prawdziwy" na znacznie ostrzejsza "kazda
         kombinacja ma byc mechanicznie znaczaca" i kosztowal 18 kandydatow bez powodu
         narracyjnego.

         GDZIE TO WIDAC: PNStartup.AuditIntensityEffect wypisuje te liste przy kazdym starcie,
         wiec przy dosypce katalogu nie trzeba jej odtwarzac dekompilatorem. -->
    <textFragment>Rozmach jest mniejszy, niz moglby byc.</textFragment>
    <!-- ZNALEZISKO Z ROZGRYWKI: ten klocek nie mial zadnej preferencji, wiec nigdy nie byl
         karany, podczas gdy PN_Mod_Noc w ciagu dnia dostawal 0.20. Skutek: trzy pierwsze
         decyzje z rzedu wybraly "Skala zdarzenia okazuje sie mniejsza..." i opisy zaczely sie
         powtarzac. Preferencja domyka te asymetrie: zlagodzenie ma sens wobec malej kolonii,
         ktora i tak ledwo daje rade - to odpowiednik waniliowej krzywej adaptacji. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>10</from>
        <to>2</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

</Defs>
