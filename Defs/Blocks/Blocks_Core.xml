<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    Katalog klockow (sekcja 5.8 koncepcji) - warstwa DANYCH.
    Dodanie wydarzenia = dopisanie klockow tutaj, bez dotykania kodu decyzyjnego.

    SCHEMAT (krok 2):
      blockType    slot: Trigger / Actor / Action / Target / Modifier / Consequence
      theme        os tematu (8 wartosci) - Raid to atak na kolonie,
                   Military to sprawy zbrojne BEZ ataku
      valence      Negative / Neutral / Positive
      scale        Minor / Moderate / Major
      intensity    Low / Normal / High - INTENCJA co do sily.
                   Na punkty incydentu tlumaczy ja IntensityTable w Integration,
                   zeby kalibracja zyla w jednym miejscu.
      conditions   TWARDE bramki - klocek niedostepny, gdy ktorakolwiek nie przejdzie.
                   Odpowiadaja za SPOJNOSC.
      preferences  MIEKKIE preferencje 0..1 - nie blokuja, skladaja sie na contextFit
                   gotowego kandydata. Odpowiadaja za KONTEKSTOWOSC.
      incompatibleWith  krawedzie grafu, deklarowane przy klocku AKCJI, zeby reguly
                   jednego wydarzenia byly w jednym miejscu.

    UWAGA: wezel musi miec PELNA nazwe typu z namespace'em - sama <NarrativeBlockDef>
    jest po cichu ignorowana przez DirectXmlLoader.

    Fragmenty tekstu skladaja sie w kolejnosci slotow:
        Trigger -> Actor -> Action -> Target -> Modifier
    Dlatego fragmenty celu i modyfikatora sa neutralne - musza brzmiec sensownie
    zarowno przy wydarzeniu negatywnym, jak i pozytywnym.
  -->

  <!-- ========================= WYZWALACZE (slot opcjonalny) ========================= -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Trig_Bogactwo</defName>
    <blockType>Trigger</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>High</intensity>
    <tags><li>rozglos</li></tags>
    <textFragment>Wiesc o zamoznosci kolonii rozeszla sie po okolicy.</textFragment>
    <!-- Zeby wiesc o bogactwie mogla sie rozejsc, kolonia musi cos miec -->
    <!-- 2.0 = kolonia dwa razy bogatsza, niz gra sie spodziewa na tym etapie.
         Prog wzgledny, bo absolutny zalezy od scenariusza startowego. -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_WealthRelative">
        <min>2.0</min>
      </li>
    </conditions>
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>2.0</from>
        <to>6.0</to>
        <weight>2</weight>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Trig_Cisza</defName>
    <blockType>Trigger</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>Normal</intensity>
    <tags><li>spokoj</li></tags>
    <textFragment>Po dniach spokoju cos w koncu zaklocilo rutyne.</textFragment>
    <!-- Ten fragment stwierdza, ze BYL spokoj - a tego wczesniej nikt nie sprawdzal.
         Gdy poprzednie wydarzenie wypadlo dzien wczesniej, zdanie bylo po prostu nieprawdziwe.
         1.5 dnia przy mtbDays=2.5 odsiewa nastepstwa "tuz po sobie", zostawiajac typowe odstepy. -->
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_CalmPeriod">
        <minDays>1.5</minDays>
      </li>
    </conditions>
    <!-- Para przeciwstawna z PN_Trig_Bogactwo: tamten wymaga kolonii dwa razy zamozniejszej
         od normy, ten pasuje do kolonii zwyczajnej. Bez wlasnej preferencji "cisza" wygrywala
         z "bogactwem" samym brakiem kary, gdy tylko bogactwo przekroczylo prog. -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>2.0</from>
        <to>0.5</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

  <!-- ================================ AKTORZY ================================ -->

  <ProceduralNarrator.Integration.Defs.NarrativeBlockDef>
    <defName>PN_Aktor_Piraci</defName>
    <blockType>Actor</blockType>
    <!-- BEZ <theme>/<valence>/<scale>: umowa danych mowi, ze charakter wydarzenia okresla
         WYLACZNIE klocek akcji. Te trzy pola byly tu deklarowane i nieczytane przez nikogo,
         co jest mylace dla autora tresci - ustawialby valence i oczekiwal efektu.
         Ten slot wnosi warunki, preferencje, tekst i intensywnosc; osi nie wnosi. -->
    <intensity>High</intensity>
    <tags><li>wrogi</li><li>ludzki</li></tags>
    <!-- REGULA "fakt w tekscie = warunek TWARDY". Poprzedni fragment brzmial "Banda piratow",
         czyli NAZYWAL konkretna frakcje - a Cond_HostileFaction sprawdza tylko, czy istnieje
         JAKAKOLWIEK wroga frakcja (WorldSnapshot.HasHostileFaction to zwykly bool). Frakcji
         napastnika przy tym nie wybieramy: do IncidentParms trafiaja wylacznie punkty, wiec
         RaidEnemy dobiera ja sam. Skutek: napad plemienia albo zbuntowanych osadnikow bylby
         opisany jako piraci.
         Zabezpieczenie warunkiem jest dzis niemozliwe (wymagaloby parametryzacji frakcji
         w IncidentParms - patrz dlug otwarty o slocie Target), wiec zgodnie z przyjeta zasada
         TEKST PRZESTAJE STWIERDZAC to, czego nie kontrolujemy. Nowy fragment mowi wylacznie to,
         co Cond_HostileFaction faktycznie gwarantuje: ze napastnik jest wrogi i ludzki. -->
    <textFragment>Wroga grupa zbrojna</textFragment>
    <conditions>
      <li Class="ProceduralNarrator.Core.Conditions.Cond_HostileFaction"/>
    </conditions>
    <!-- Piratow przyciaga bogactwo i slabo broniona kolonia -->
    <preferences>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_WealthRelative">
        <from>0.8</from>
        <to>4.0</to>
        <weight>2</weight>
      </li>
      <li Class="ProceduralNarrator.Core.Conditions.Pref_Colonists">
        <from>10</from>
        <to>2</to>
      </li>
    </preferences>
  </ProceduralNarrator.Integration.Defs.NarrativeBlockDef>

