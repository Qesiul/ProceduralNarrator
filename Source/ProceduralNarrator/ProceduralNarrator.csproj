<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ProceduralNarrator</AssemblyName>
    <RootNamespace>ProceduralNarrator</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- DLL ladujemy prosto do folderu moda, bez podkatalogu z nazwa frameworka -->
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>

    <!-- Assembly gry sa juz zaladowane przez RimWorld; kopiowanie ich do moda
         to czesty blad - niepotrzebnie wazy i potrafi powodowac konflikty. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <RimWorldManaged>..\..\..\..\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
